PORT=4000
# Public URLs. Slack requires an https redirect URI, so use an ngrok URL for BACKEND_URL when testing Slack.
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me

DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Worker / throttling (all configurable, nothing hardcoded)
START_WORKER=true
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
SENDERS_PER_USER=2
